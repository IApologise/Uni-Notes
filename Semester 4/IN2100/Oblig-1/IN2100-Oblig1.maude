--- Exercise 9: Implementation of monus, min, odd, even.
fmod NAT1 is extending NAT< .
  ops _monus_ min : Nat Nat -> Nat .  --- Operators have two inputs of type Nat and output a single Nat.
  ops odd even : Nat -> Boolean .     --- Operators take Nat as input and output a Boolean.

  --- Some variables
  vars M N : Nat .
  var B : Boolean .

  --- Explaining monus
  eq M monus 0 = M .
  eq 0 monus M = 0 .
  eq s(M) monus s(N) = M monus N .

  --- Explaining min
  eq min(M, 0) = 0 .
  eq min(0, M) = 0 .
  eq min(s(M), s(N)) = s(min(M, N)) .

  --- Explaining odd
  eq odd(0) = false .
  eq odd(s(0)) = true .
  eq odd(s(s(M))) = odd(M) .

  --- Explaining even
  eq even(0) = true .
  eq even(s(0)) = false .
  eq even(s(s(M))) = even(M) .
endfm

--- Some test commands:
red s(s(s(s(s(0))))) monus s(s(0)) .
red s(s(0)) monus s(s(s(0))) .
red s(0) monus s(0) .
red min(s(0), s(0)) .
red min(0, s(s(s(0)))) .
red min(s(s(s(s(0)))), s(s(0))) .
red odd(0) .
red even(0) .
red odd(s(s(s(s(0))))) .
red even(s(s(s(s(0))))) .
red odd(s(s(s(s(s(0)))))) .
red even(s(s(s(s(s(0)))))) .



