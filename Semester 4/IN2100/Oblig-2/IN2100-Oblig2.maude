--- Exercises from 28.1 to 28.6
fmod STRING is

  --- Exercise 28.1: Implementation of Char and String
  sorts Char String .
  subsort Char < String .

  ops a b c d e f g h i j k l m n o p q r s t u v w x y z : -> Char [ctor] .
  op nil : -> String [ctor] .
  op __ : String String -> String [assoc id: nil ctor] .

  --- Setup for the rest of the sub exercises
  op isPal : String -> Bool .
  op _prefixOf_ : String String -> Bool .
  op _substringOf_ : String String -> Bool .

  vars C C' : Char .
  vars S S' : String .

  --- Exercise 28.2: Explaining isPal
  eq isPal(nil) = true .
  eq isPal(C) = true .
  eq isPal(C S C') = isPal(S) and C == C' .

  --- Exercise 28.3: Explaining prefixOf
  eq nil prefixOf S = true .
  eq S prefixOf nil = false .
  eq C S prefixOf C' S' = S prefixOf S' and C == C' .

  --- Exercise 28.4: Explaining substringOf
  eq nil substringOf S' = true .
  eq S substringOf nil = false .
  eq S substringOf C' S' = if S prefixOf C' S' then true else S substringOf S' fi .

  --- Exercise 28.5: Explaining Pattern and ?
  sort Pattern .
  subsort String < Pattern .

  op ? : -> Pattern [ctor] .
  op __ : Pattern Pattern -> Pattern [assoc id: nil ctor] .

  --- Exercise 28.6: Explaining some more
  op _prefixOf_ : Pattern String -> Bool .
  op _substringOf_ : Pattern String -> Bool .

  var P : Pattern .

  --- prefixOf
  eq P prefixOf nil = false .
  eq ? P prefixOf C' S' = P prefixOf S' .
  eq C P prefixOf C' S' = P prefixOf S' and C == C' .

  --- substringOf
  eq P substringOf nil = false .
  eq P substringOf C' S' = if P prefixOf C' S' then true else P substringOf S' fi .

endfm

--- My own tests
red nil prefixOf nil .   --- true
red a prefixOf nil .     --- false
red nil prefixOf a .     --- true
red a prefixOf a .       --- true
red nil substringOf nil .   --- true
red a substringOf nil .     --- false
red nil substringOf a .     --- true
red a substringOf a .       --- true

--- More advanced tests
red b a c prefixOf n m b a c x .   --- false
red c m prefixOf c m a b c .       --- true
red q o v prefixOf nil .           --- false
red n prefixOf n l k .             --- true
red a c substringOf o p a c c b .     --- true
red p substringOf n o t p a r t y .   --- true
red l l o substringOf w o r l d .     --- false
red r o l l substringOf nil .         --- false

--- How can "nil prefixOf nil" give both true and false?
--- I also have the exact same question to the "nil substringOf nil".
--- As I can see from my tests they are confluent. I did not find a single mistake.
--- An empty string is in fact in an empty string. Same in many other languages like Python.



--- Exercises 30 and 32
fmod MSET-INT is
  protecting INT .

  sorts Mset NeMset .                   *** Multisets and non-empty multisets
  subsorts Int < NeMset < Mset .        *** A number is also a multiset
  
  op none : -> Mset [ctor] .            *** Empty multiset
  op __ : Mset Mset -> Mset [ctor assoc comm id: none] .
  op __ : NeMset NeMset -> NeMset [ctor assoc comm id: none] .

  op size : Mset -> Nat .               *** No of elements in a multiset
  op mult : Int Mset -> Nat .           *** Multiplicity of an element
  op delete : Int Mset -> Mset .        *** Remove ONE occurrence of element
  op _in_ : Int Mset -> Bool .          *** Is element in multiset?
  op max : NeMset -> Int .              *** Largest element
  op empty? : Mset -> Bool .            *** Empty?
  op _>mul_ : Mset Mset -> Bool .       *** Multiset comparison

  vars I J : Int .
  vars MS MS' : Mset .  vars NEMS NEMS' : NeMset .

  eq delete(I, I MS) = MS .
  ceq delete(I, MS) = MS if not I in MS .
  eq I in MS = mult(I, MS) > 0 .

  --- Exercise 30: Implement size, mult, max, empty?, >mul
  --- Explaining size
  eq size(none) = 0 .
  eq size(I MS) = 1 + size(MS) .

  --- Explaining mult
  eq mult(I, none) = 0 .
  eq mult(I, MS J) = if I == J then 1 + mult(I, MS) else mult(I, MS) fi .

  --- Explaining max
  eq max(I) = I .
  eq max(MS I J) = max(MS if I < J then J else I fi) .

  --- Explaining empty?
  eq empty?(none) = true .
  eq empty?(MS) = false .

  --- Helper function to remove all duplicates (Also hate it cuz it's slow)
  --- I could make it better but I am too lazy for that
  --- I will just wait for a way more elegant solution in the feedback
  op delDupes : Mset Mset -> Mset .
  eq delDupes(none, MS) = none .
  eq delDupes(MS, none) = MS .
  eq delDupes(I MS, MS') = if I in MS' then delDupes(MS, delete(I, MS')) else I delDupes(MS, MS') fi .

  --- Explaining >mul
  eq none >mul MS = false .
  eq MS >mul none = true .
  eq MS >mul MS' = max(delDupes(MS, MS')) >= max(delDupes(MS', MS)) .
  --- Very inefficient, I am crying right now ;(
  --- But it was easy to make so I am happy :D
  --- Also, it works :)

  --- Exercise 32: Explaining Mset-ObjMsg
  sorts Obj Msg Mset-ObjMsg .
  subsorts Obj Msg < Mset-ObjMsg .
  
  op empty : -> Mset-ObjMsg [ctor] .
  op __ : Mset-ObjMsg Mset-ObjMsg -> Mset-ObjMsg [assoc id: empty] .
  --- Pretty sure I answered exercise 32, what else did I have to make?
  --- There are the defined sorts, don't see the problem...
  --- Nothing was mentioned about the operators or such.

endfm

